---
interface Props {
  repo?: string;
  href?: string;
  variant?: 'inline' | 'mono';
}

const {
  repo = 'BetterWallet/solana-firmware',
  href = `https://github.com/${repo}`,
  variant = 'inline',
} = Astro.props;

let stars: number | null = null;
try {
  const res = await fetch(`https://api.github.com/repos/${repo}`, {
    headers: { 'User-Agent': 'better-wallet-pi-landing' },
  });
  if (res.ok) {
    const data = await res.json();
    if (typeof data.stargazers_count === 'number') stars = data.stargazers_count;
  }
} catch { /* graceful fallback */ }

const formatted =
  stars === null
    ? null
    : stars >= 1000
      ? `${(stars / 1000).toFixed(1).replace(/\.0$/, '')}k`
      : stars.toString();
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group inline-flex items-center gap-2 font-mono text-bone-mute hover:text-bone"
  style="font-size: 11px; letter-spacing: 0.16em;"
  aria-label={`Star ${repo} on GitHub${formatted ? ` (${formatted} stars)` : ''}`}
>
  <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-current" aria-hidden="true">
    <path d="M8 0.25a8 8 0 00-2.53 15.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2 .37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 008 0.25z"/>
  </svg>
  <span class="uppercase">Star</span>
  {formatted && (
    <span class="inline-flex items-center gap-2">
      <span class="h-3 w-px bg-wire-hi" aria-hidden="true"></span>
      <span class="tabular-nums text-bone">{formatted}</span>
    </span>
  )}
</a>
